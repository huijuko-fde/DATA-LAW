    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규칙은 「민법」에 따라 국무조정실장이 주무관청이 되는 비영리법인의 설립 및 감독에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "20211222",
        "relations": [],
        "revision_type": "제정",
        "changed": "Y",
        "article_key": "0001001",
        "moved": "000000",
