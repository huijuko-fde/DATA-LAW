        "article_title": "하부조직",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(하부조직) 특별감찰관에 특별감찰과를 둔다.",
        "enforcement_date": "20140619",
        "relations": [],
        "revision_type": "제정",
        "changed": "Y",
        "article_key": "0005001",
        "moved": "000000",
